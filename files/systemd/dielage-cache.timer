[Unit]
Description=Check Die Lage cache interval

[Timer]
# Do not compete with Plasma, Akonadi and other login work. The first regular
# cache check starts three minutes after the user manager/session starts.
# After that, check every minute so fetch_interval_minutes=1 remains possible.
# The cache script exits immediately when the cache is still fresh.
OnStartupSec=3min
OnUnitActiveSec=1min
# Let systemd coalesce this wake-up with other timers instead of forcing a
# dedicated wake every 60 s. Saves battery on laptops at no visible cost.
AccuracySec=20s
Unit=dielage-cache.service

[Install]
WantedBy=timers.target
