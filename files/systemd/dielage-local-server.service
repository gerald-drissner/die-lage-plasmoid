[Unit]
Description=Local server for Die Lage
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
ExecStart=%h/.local/bin/dielage-server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
# The server itself is lightweight, but manual refreshes are child processes
# in this same cgroup. Give them the same tested ceiling as timer-driven cache
# refreshes; this is a cap, not reserved memory.
MemoryMax=768M
TasksMax=64

[Install]
WantedBy=default.target
