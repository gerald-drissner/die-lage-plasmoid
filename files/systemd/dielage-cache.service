[Unit]
Description=Update Die Lage cache
After=network-online.target
Wants=network-online.target
# Note: no [Install] section — this service is triggered by dielage-cache.timer,
# not enabled directly.  "systemctl --user enable dielage-cache.service" is a
# no-op; enable the .timer instead.

[Service]
Type=oneshot
SuccessExitStatus=75
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=64
ExecStart=%h/.local/bin/dielage-cache.py
