[Unit]
Description=Initial Die Lage cache refresh after login/reboot
After=network-online.target dielage-local-server.service
Wants=network-online.target
# Note: no [Install] section — triggered by dielage-cache-boot.timer.

[Service]
Type=oneshot
SuccessExitStatus=75
UMask=0077
Nice=10
IOSchedulingClass=idle
# Same hardening as dielage-cache.service. Both run the identical script, so
# running one of them with fewer restrictions than the other made no sense.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=64
ExecStart=%h/.local/bin/dielage-cache.py --force
